# Ligne / fin de ligne : forcer LF pour les scripts shell et les YAML
# (indispensable sous Windows : CRLF casse les scripts bash sur le guest).
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.txt text eol=lf

# Rapports PDF : binaires
*.pdf binary
*.png binary
*.jpg binary
*.iso binary
*.vdi binary

# Fichiers de l'outillage
*.bat text eol=crlf
*.cmd text eol=crlf
